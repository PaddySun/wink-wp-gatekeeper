# 模板文件（可入库）。复制为外层 ...env（或直接填写本文件后移出仓库）——真实密钥严禁入库
# ================================================================
# wink-wp-gatekeeper 第三方 API 凭据（真机验证 / 部署用）
#
# 填写说明：
#   - 等号后直接写值，不加引号；暂无/未启用的项保留空即可
#   - 本文件含密钥：放外层目录（不在插件 git 仓库内），严禁提交/截图/外发
#   - 正式站点运行时密钥存 wp_options（设置页填写），本文件供部署脚本/
#     驱动自检/真机核对脚本读取
# ================================================================

# ----------------------------------------------------------------
# M1 · 腾讯天御验证码 2.0（CaptchaDriver 首发）——上线前置项
# ----------------------------------------------------------------
# 验证码控制台 https://console.cloud.tencent.com/captcha → 验证管理 → CaptchaAppId
WINK_TENCENT_CAPTCHA_APP_ID=

# TC3 签名用 CAM 密钥对 https://console.cloud.tencent.com/cam/capi
# 建议子账号 + 最小权限（QcloudCaptchaFullAccess）
WINK_TENCENT_SECRET_ID=
WINK_TENCENT_SECRET_KEY=

# 备用：验证码控制台同页的 AppSecretKey——仅当核验返回 MissingParameter.AppSecretKey
# 时才需要填写（05 §1.1 实现注意④ 的三态核对路径）
WINK_TENCENT_CAPTCHA_APP_SECRET_KEY=

# ----------------------------------------------------------------
# M3 · 云审核（ReviewDriver · LLM 首发）
# ----------------------------------------------------------------
# DeepSeek https://platform.deepseek.com → API Keys（Bearer 用）
WINK_DEEPSEEK_API_KEY=

# 可选：自定义 OpenAI 兼容端点（中转/自建网关，必须 https）
WINK_OPENAI_CUSTOM_BASE_URL=
WINK_OPENAI_CUSTOM_API_KEY=
WINK_OPENAI_CUSTOM_MODEL=

# 可选：模力 System One（结构化推理备选驱动）
WINK_MOLI_API_KEY=

# ----------------------------------------------------------------
# M3 · IP 信誉（IPDriver）
# ----------------------------------------------------------------
# AbuseIPDB https://www.abuseipdb.com/account/api（免费档 1000 次/天）
WINK_ABUSEIPDB_API_KEY=

# ----------------------------------------------------------------
# M4 · 传统云审核（可选；驱动实现前须补抓官方文档核对）
# ----------------------------------------------------------------
# 百度智能云文本审核：API Key + Secret Key
WINK_BAIDU_TEXT_API_KEY=
WINK_BAIDU_TEXT_SECRET_KEY=

# 阿里云内容安全（Green）：RAM AccessKey
WINK_ALIYUN_GREEN_ACCESS_KEY_ID=
WINK_ALIYUN_GREEN_ACCESS_KEY_SECRET=

# 腾讯云 TMS：可与天御共用同一 CAM 密钥对（若权限未拆分则同值）
WINK_TENCENT_TMS_SECRET_ID=
WINK_TENCENT_TMS_SECRET_KEY=
# TMS 控制台策略编号（TextModeration 必填）
WINK_TENCENT_TMS_bizType=

# ----------------------------------------------------------------
# M4 · 其余验证码驱动（可选，按站长选配）
# ----------------------------------------------------------------
# 阿里云验证码 2.0：AccessKey + 场景 SceneId + 身份标 prefix（控制台概览页）
WINK_ALIYUN_CAPTCHA_ACCESS_KEY_ID=
WINK_ALIYUN_CAPTCHA_ACCESS_KEY_SECRET=
WINK_ALIYUN_CAPTCHA_SCENE_ID=
WINK_ALIYUN_CAPTCHA_PREFIX=

# hCaptcha：https://dashboard.hcaptcha.com（sitekey 公开/secret 服务端）
WINK_HCAPTCHA_SITE_KEY=
WINK_HCAPTCHA_SECRET_KEY=

# Cloudflare Turnstile：https://dash.cloudflare.com → Turnstile
WINK_TURNSTILE_SITE_KEY=
WINK_TURNSTILE_SECRET_KEY=

# 极验 v4：https://www.geetest.com（captcha_id/captcha_key）
WINK_GEETEST_CAPTCHA_ID=
WINK_GEETEST_CAPTCHA_KEY=

# ----------------------------------------------------------------
# 真机验证辅助（可选）
# ----------------------------------------------------------------
# 测试站地址（一阶段可填 http://<厦门机IP>）
WINK_TEST_SITE_URL=
# 站长联系邮箱（拦截文案 {contact_email} 占位符用）
WINK_CONTACT_EMAIL=
